# =====================================================================
# Binance COIN-M Futures 자동매매봇 V1 설정 예시
#   이 파일을 binance_coinm_v1/.env 로 복사해서 쓴다.
#   실제 .env 는 git 에 올라가지 않는다 (저장소 .gitignore + 이 폴더 .gitignore).
#   저장소 루트의 업비트 .env 는 읽지 않는다 (두 봇은 설정을 공유하지 않음).
#   값 옆에 주석을 달지 말고, 주석은 따로 한 줄에 쓴다.
# =====================================================================

# ---- API 키 (소스코드·README·로그·텔레그램·DB·테스트 결과에 절대 기록되지 않는다) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- 실행 환경 ----
# BINANCE_ENV: live (dapi.binance.com) | testnet (testnet.binancefuture.com)
BINANCE_ENV=live
# EXECUTION_MODE: paper (기본, 거래소로 주문을 보내지 않음) | testnet | live
EXECUTION_MODE=paper
# 실거래는 아래 4개가 전부 맞아야 하고, 바이낸스 전용 검증 게이트도 통과해야 한다:
#   BINANCE_ENV=live, EXECUTION_MODE=live, LIVE_TRADING_ENABLED=true,
#   LIVE_CONFIRMATION=I_UNDERSTAND_LIVE_TRADING
LIVE_TRADING_ENABLED=false
LIVE_CONFIRMATION=

# ---- 계약·계정 (V1 은 격리·원웨이만 지원) ----
SYMBOL=BTCUSD_PERP
MARGIN_TYPE=ISOLATED
POSITION_MODE=ONE_WAY
# 레버리지는 증거금 크기만 정한다 (위험·수량 계산에 쓰지 않음, 자동 상향 없음)
LEVERAGE=3

# ---- 위험 (BTC 기준) ----
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2.0
MAX_POSITIONS=1
# 명목가치 상한 = equity x 이 값 (노출 한도)
MAX_EXPOSURE_MULTIPLE=3.0
# 청산가까지 거리 >= 손절 거리 x 이 값
LIQ_GUARD_MIN_RATIO=2.0

# ---- 전략 (Trendy Kangaroo, 1h 신호 / 4h 존) ----
ENTRY_VALID_BARS=2
MAX_HOLD_BARS=72
EXIT_MODE=ladder
# TP1,TP2,TP3 부분청산 비율 (초기 수량 대비, 나머지는 추적). 0,0,0 이면 원본 업비트 ladder
LADDER_TP_FRACTIONS=0.25,0.25,0.25
# long,short | long | short
DIRECTIONS=long,short
MIN_RR=1.0

# ---- 트리거 가격 종류 (MARK_PRICE | CONTRACT_PRICE) ----
# 보호 손절(STOP_MARKET). 비우면 MARK_PRICE
MARKET_TRIGGER_TYPE=
# 목표(TAKE_PROFIT_MARKET). 비우면 CONTRACT_PRICE
TP_TRIGGER_TYPE=
# 돌파 진입 판정 가격
ENTRY_TRIGGER_TYPE=CONTRACT_PRICE
STOP_PRICE_PROTECT=false

# ---- 비용 가정 (실거래는 시작 시 commissionRate 로 덮어씀) ----
TAKER_FEE_RATE=0.0005
MAKER_FEE_RATE=0.0002
SLIPPAGE_BPS=3
STOP_SLIPPAGE_BPS=5

# ---- 복구 정책 ----
# 로컬 기록 없는 포지션: protect (손절 걸고 사람 확인까지 신규 진입 차단) | close (즉시 청산)
ORPHAN_POSITION_POLICY=protect
ORPHAN_STOP_PCT=3.0
# 이 봇이 만들지 않은 주문이 있으면: block (신규 진입 차단) | ignore
FOREIGN_ORDER_POLICY=block
RESTART_PENDING_GRACE_SEC=120

# ---- 종이 매매 ----
PAPER_START_EQUITY_BTC=0.007

# ---- 표시용 환율 (fixed | upbit_usdt) ----
USD_KRW_SOURCE=fixed
USD_KRW_RATE=1390

# ---- 텔레그램 (알림 전용, 비우면 로그로만) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 검증 게이트 ----
VALIDATION_MIN_TRADES=100
VALIDATION_MIN_DSR=0.95
VALIDATION_MAX_PBO=0.5
VALIDATION_MAX_DD_PCT=30
VALIDATION_MIN_PAPER_TRADES=30
VALIDATION_MAX_AGE_DAYS=3

# ---- 상태 폴더 (비우면 binance_coinm_v1/state) ----
STATE_DIR=
