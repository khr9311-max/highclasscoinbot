[Unit]
Description=Coinbot meta-model training progress notifier
After=network-online.target

[Service]
Type=oneshot
# meta_trainer 가 pandas/lightgbm 을 쓰므로 코인봇 venv 를 그대로 쓴다.
# (watchdog.py 와 달리 이건 안전장치가 아니라 정보성 알림이라, venv 의존을
# 감수한다 - venv 가 깨지면 이 알림만 조용히 실패하고 서비스 자체의 생사는
# 여전히 coinbot-watchdog 가 감시한다)
ExecStart=/opt/coinbot/.venv/bin/python /opt/coinbot/deploy/meta_progress.py
# journalctl 과 /etc/coinbot/coinbot.env 를 읽어야 해서 root 로 실행한다.
User=root
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=coinbot-meta-progress
