# Optional dedicated credential file. Default runtime reads only API key/secret
# from binance_coinm_v1/.env; legacy root .env is explicitly refused.
# Use --credentials-file btc_spot/.env if copying this file.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Mode and allocation are explicit CLI arguments, not inherited from old bots.
# Default: paper, 0.003 BTC, BTCUSDT, no margin/borrowing/transfers.
