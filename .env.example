# ===== 로컬 개발용. AWS 에서는 SSM Parameter Store 를 쓴다 =====
# (COINBOT_SECRETS=ssm 로 두면 이 파일 대신 /coinbot/* 파라미터를 읽음)

# Upbit API Keys (발급: https://upbit.com/service_center/open_api_guide)
# 주의: 주문 권한 키는 업비트에 '허용 IP' 를 등록해야 한다.
UPBIT_OPEN_API_ACCESS_KEY="여기에_업비트_ACCESS_KEY를_입력하세요"
UPBIT_OPEN_API_SECRET_KEY="여기에_업비트_SECRET_KEY를_입력하세요"

# Telegram (선택 - 미설정 시 알림만 비활성화)
TELEGRAM_BOT_TOKEN="여기에_텔레그램_BOT_TOKEN을_입력하세요"
TELEGRAM_CHAT_ID="여기에_텔레그램_CHAT_ID를_입력하세요"

# Gemini API Key (발급: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="여기에_제미나이_API_KEY를_입력하세요"

# ===== 실행 모드 =====
# true = 모의주문(기본). 실주문을 내려면 false 로 바꿔야 한다.
DRY_RUN=true

# ===== 리스크 한도 (미설정 시 config.py 기본값 사용) =====
ORDER_SIZE_KRW=10000
MAX_POSITION_KRW=50000
MAX_TOTAL_EXPOSURE_KRW=150000
DAILY_LOSS_LIMIT_KRW=30000
MAX_ORDERS_PER_DAY=40
ORDER_COOLDOWN_SEC=60

# ===== 기타 =====
GEMINI_MODEL=gemini-3.6-flash
COINBOT_STATE_DIR=state

# ---- 배포 편의용 (시크릿 아님) ----
# COINBOT_EC2_HOST="15.165.144.204"
