[Unit]
Description=BTC Lab PUBLIC DATA PAPER ONLY (no exchange orders)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=btc-lab
Group=btc-lab
WorkingDirectory=/opt/btc-lab/current
EnvironmentFile=/etc/btc-lab/paper.conf
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
UnsetEnvironment=BINANCE_API_KEY BINANCE_API_SECRET TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
ExecStart=/opt/btc-lab/current/.venv/bin/python -m btc_lab.forward --equity ${BTC_PAPER_EQUITY} --fee ${BTC_PAPER_FEE} --maint-margin-rate ${BTC_PAPER_MAINT_MARGIN_RATE} --candidate ${BTC_PAPER_CANDIDATE} --state-dir /var/lib/btc-lab-paper
Restart=on-failure
RestartSec=15
RestartPreventExitStatus=2
KillSignal=SIGINT
KillMode=control-group
TimeoutStopSec=300
StateDirectory=btc-lab-paper
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/var/lib/btc-lab-paper
StandardOutput=journal
StandardError=journal
SyslogIdentifier=btc-lab-paper
LogNamespace=btc-lab
MemoryMax=1G
TasksMax=64

[Install]
WantedBy=multi-user.target
